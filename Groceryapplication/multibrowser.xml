	<test thread-count="5" name="Test1">
		<classes>
			<class name="testScripts.LoginTest">
			<methods>
					<include name="verifyUserLoginWithValidCredentials"></include>
			</methods>
		</class>

		</classes>
	</test> 
	
	<test thread-count="5" name="Test2">
	<parameter name="browsers" value="firefox"></parameter>
		<classes>
			<class name="testScripts.HomeTest">
		</class>

		</classes>
	</test>
	<!--
	Test -->
</suite> <!--
Suite -->
